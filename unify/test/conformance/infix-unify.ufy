// Conformance: infix '=' (SPEC.md section 4 and 8).
// The parser desugars `lhs = rhs` into a goal unify(lhs, rhs)
// (AnyTermFactory::operator()(InfixTermsInput), op=='='), resolved by
// UnifyBuiltinClause (vault-unify-clause-builtin-unify.cpp), which just
// forwards to the normal double-dispatch unifyTerm on its two arguments.

to_1( $a ) { $a = 1; }

query {
    to_1( $v );
    print( $v );
}

query {
    1 = 1;
    print( "equal-constants" );
}

query {
    1 = 2;
    print( "should-not-print-unequal-constants" );
}

query {
    $w = five;
    print( $w );
}
