// Conformance: map/map unification (SPEC.md section 6).
// MapTerm::unifyMapTerm requires equal size first, then walks both maps'
// (std::map-sorted) key/value pairs pairwise: same key set required, and
// every value at a shared key must itself unify. Any key/size mismatch
// fails the whole unification (no partial/subset match).

query {
    { x: 1, y: 2 } = { x: 1, y: 2 };
    print( "maps-equal" );
}

query {
    { x: 1, y: 2 } = { x: 1, y: 3 };
    print( "should-not-print-value-mismatch" );
}

query {
    { x: 1, y: 2 } = { x: 1 };
    print( "should-not-print-size-mismatch" );
}
