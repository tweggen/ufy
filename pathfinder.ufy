aeotec_multisensor_5_value_changed( $event, "True" )
{
//	print( here3 );
	push_event( { type: event_person_detected, location: office } );
}


aeotec_multisensor_5_value_changed( $event, "False" )
{
//	print( here2 );
	push_event( { type: event_nobody_detected, location: office } );
}


event_reaction( zw_value_changed, $event )
{
	"ozw0x0184e7b70x05" = $event->zw_node_id;
	aeotec_multisensor_5_value_changed( $event, $event->zw_value_string );
}


aeotec_multisensor_6_basic_set( $event, "255" )
{
	push_event( { type: event_person_detected, location: kitchen } );
}


aeotec_multisensor_5_value_changed( $event, "0" )
{
	push_event( { type: event_nobody_detected, location: kitchen } );
}


event_reaction( zw_node_basic_set, $event )
{
	"ozw0x0184e7b70x08" = $event->zw_node_id;
	aeotec_multisensor_6_basic_set( $event, $event->zw_event );
}

