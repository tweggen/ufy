// Conformance: `if (cond) { ... }` soft-if semantics (SPEC.md sections 4
// and 9): like Prolog's `( cond, body ; true )`. If cond succeeds, body
// runs and execution continues after the if; if cond fails, execution
// continues after the if directly. Prints before/after each `if` (and
// inside its body) prove the rest of the query keeps running either way.
//
// QUIRK (no cut yet, ROADMAP Phase 2, SPEC.md section 9): the first query
// below has a cond that succeeds, but since this engine backtracks to
// find every solution (not just the first) and there is no cut to commit
// to the then-branch, the synthesized fallback clause is ALSO tried after
// the then-branch's solution is found -- so "after-then-query" prints
// TWICE: once continuing from the then-branch, once continuing from the
// (still attempted) fallback.

flag( on );

query {
    print( "before-then-query" );
    if( flag( on ) ) { print( "then-branch" ); }
    print( "after-then-query" );
}

query {
    print( "before-else-query" );
    if( flag( off ) ) { print( "else-branch" ); }
    print( "after-else-query" );
}
