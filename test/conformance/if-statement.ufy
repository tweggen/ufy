// Conformance: `if (cond) { ... }` real if-then-else semantics (SPEC.md
// sections 4 and 9; ROADMAP Phase 2 "Cut"): like Prolog's
// `( cond, !, body ; true )`. If cond succeeds, body runs (once, committed
// via the cut the desugaring now inserts right after cond) and execution
// continues after the if; if cond fails, the fallback (always succeeds,
// empty body) runs and execution continues after the if directly either
// way. Prints before/after each `if` (and inside its body) prove the rest
// of the query keeps running either way.
//
// Before cut existed (ROADMAP Phase 2), this was a soft-if with no commit:
// the first query below has a cond that succeeds, but since this engine
// backtracks to find every solution, the synthesized fallback clause was
// ALSO tried after the then-branch's solution was found, so
// "after-then-query" printed TWICE. Cut now prunes that fallback once cond
// has succeeded, so it prints once.

flag( on );

query {
    print( "before-then-query" );
    if( flag( on ) ) { print( "then-branch" ); }
    print( "after-then-query" );
}

query {
    print( "before-else-query" );
    if( flag( off ) ) { print( "else-branch" ); }
    print( "after-else-query" );
}
