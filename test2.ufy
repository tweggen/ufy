

log( $x )
{
	print( $x );
} 

///// BOB Bindings start.

/*
 * A device endpoint is at the given location if bob says the device is.
 */
endpoint_at_location( endpoint( $device, $_anything ), $location )
{
	bob_device_location( $device, $location );
}

/*
 * Basic driver for a fibaro light bulb.
 */
event_reaction( hello_request, $event )
{
	print( "Hello 1" );
	bob_device_attribute( $event->device, "lights_active" );
	print( "Hello 2" );
	zw_node( $event->device );
	print( "Hello 3" );
	zw_switch_binary( $event->device, 1, 1 );
}

/*
 * Basic driver for aeotec multisensor 6 configured to send basic set statements.
 *
 * If motion is detected, this event is set:
 * 	device: $deviceId
 *  location: $location
 *  type: {event_person_detected|event_nobody_detected}
 */

/** 
 * React on a multisensor in basic set mode.
 */

aeotec_multisensor_6_basic_set_type( "255", event_person_detected );
aeotec_multisensor_6_basic_set_type( "0", event_nobody_detected );

aeotec_multisensor_6_basic_set( $event, $basic_set_value )
{
	print( "aeotec_multisensor_6_basic_set 1");
	bob_device_location( $event->zw_node_id, $location );
	print( "aeotec_multisensor_6_basic_set 2") ;
	print( $location );
	aeotec_multisensor_6_basic_set_type( $event->zw_event, $event_type );
	print( $event_type );
	// TXWTODO: Thy does push_event emit two different events?
	push_event( { 
	 	device: $event->zw_node_id,
	 	type: $event_type,
		location: $location 
	} );
	// Workaround was:
	// event_reaction( $event_type, { 
	//  	device: $event->zw_node_id,
	// 	type: $event_type,
	// 	location: $location 
	// });
}

event_reaction( zw_basic_set, $event )
{
	// TXWTODO: Write device_type
	// bob_device_type( $event->zw_node_id, "0x042101" );
	"ozw0x04" = $event->zw_basic_type;
	"ozw0x21" = $event->zw_generic_type;
	"ozw0x01" = $event->zw_specific_type;
	print( "Multisensor 6 basic set 2" );
	aeotec_multisensor_6_value_changed( $event, $event->zw_event );
	print( "Multisensor 6 basic set 3" );
}

/**
 * React on a multisensor in value_changed mode.
 */

aeotec_multisensor_6_value_changed_type( "True", event_person_detected );
aeotec_multisensor_6_value_changed_type( "False", event_nobody_detected );

aeotec_multisensor_6_value_changed( $event )
{
	print( "aeotec_multisensor_6_value_changed 0");
	// React on sensor events.
	"Sensor" = $event->zw_value_label;
	print( "aeotec_multisensor_6_value_changed 1");
	bob_device_location( $event->zw_node_id, $location );
	print( "aeotec_multisensor_6_value_changed 2") ;
	print( $location );
	aeotec_multisensor_6_value_changed_type( $event->zw_value_string, $event_type );
	print( $event_type );
	
	push_event( { 
	 	device: $event->zw_node_id,
		type: $event_type,
		location: $location 
	} );
	// event_reaction( $event_type, { 
	// 	device: $event->zw_node_id,
	//	type: $event_type,
	//	location: $location 
	// });
}

event_reaction( zw_value_changed, $event )
{
	// TXWTODO: Write device_type
	// bob_device_type( $event->zw_node_id, "0x042101" );
	"ozw0x04" = $event->zw_basic_type;
	"ozw0x21" = $event->zw_generic_type;
	"ozw0x01" = $event->zw_specific_type;
	print( "Multisensor 6 value changed. 2" );
	aeotec_multisensor_6_value_changed( $event );
	print( "Multisensor 6 value changed 3" );
}

/**
 * Driver for aeotec key fob
 */
event_reaction( zw_scene_event, $event )
{
	// Aeotec key fob?
	print( "Keytec 0" );
	"ozw0x01" = $event->zw_basic_type;
	"ozw0x01" = $event->zw_generic_type;
	"ozw0x01" = $event->zw_specific_type;
	print( "Keytec 1" );
	event_reaction( event_trigger_pressed, 
		$event
		/*{
		device: $event->zw_node_id,
		scene: $event->zw_scene_id,
		// This is a mobile device.
		location: is_mobile
	}*/);
}

/////////////////////////////////////////////////////////////////////////////
// Event API definition
/////////////////////////////////////////////////////////////////////////////

/*
 * API method to emit an event to a location.
 */
push_event( $event )
{
	print( "Pushing event" );
	print( $event );
	event_reaction( $event->type, $event );
}


////// Behavior Definition: Lights on motion (id "m1-sc01")

/**
 * If a person detected is received by a sensor in the behavior, Switch
 * on all lamps associated with the behavior.
 */
event_reaction( event_person_detected, $event )
{
	print( "01: person_detected called." );
	// Is the sending device configured as sensor role in the behavior?
	bob_device_role( $event->device, "m1-sc01-ro01" );
	// Find all devices with lamp role in behavior.
	bob_device_role( $lampDevice, "m1-sc01-ro02");
	// Switch on all of them.
	zw_switch_binary( $lampDevice, 1, 1 );
}

/**
 * If no person is detected by a sensor in the behavior, switch
 * on all lamps associated with the behavior.
 */
event_reaction( event_nobody_detected, $event )
{
	print( "01: nobody_detected called." );
	// Is the sending device configured as sensor role in the behavior?
	bob_device_role( $event->device, "m1-sc01-ro01" );
	// Find all devices with lamp role in behavior.
	bob_device_role( $lampDevice, "m1-sc01-ro02");
	// Switch off all of them.
	zw_switch_binary( $lampDevice, 1, 0 );
}


////// Behavior Definition: Light on Trigger (id "m1-sc02")

// If it is on, switch off and vice versa.
sc02_lamp_target_value( "True", 0 ); 
sc02_lamp_target_value( "False", 1 ); 

event_reaction( event_trigger_pressed, $event )
{
	print( "02: trigger_pressed called." );
	print( $event );
	// Is the sending device configured as trigger in the behavior?
	bob_device_role( $event->zw_node_id, "m1-sc02-ro02" );
	print( "02.1" );
	print( $event );
	"1" = $event->zw_scene_id;
	print( "02.2" );
	// Find light to trigger.
	bob_device_role( $lampDevice, "m1-sc02-ro01" );
	print( "02.3" );
	// Get current state
	zw_switch_binary( $lampDevice, 1, $lampCurrentStatus );
	print( "02.4" );
	// Look up new state.
	sc02_lamp_target_value( $lampCurrentStatus, $lampNewStatus );
	print( "02.5" );
	// Set it.
	zw_switch_binary( $lampDevice, 1, $lampNewStatus );
	print( "02.6" );
}


////// Behavior Definition: Join other TV (id "m1-sc03")

event_reaction( event_trigger_pressed, $event )
{
	print( "03: trigger_pressed called." );
	print( $event );
	// Is the sending device configured as trigger in the behavior?
	bob_device_role( $event->zw_node_id, "m1-sc03-ro03" );
	print( "03.1" );
	// bob_device_role( $event->device, "m1-sc03-ro03" );
	"3" = $event->zw_scene_id;
	print( "03.2" );
	// Find Master TV.
	bob_device_role( $tvMaster, "m1-sc03-ro01" );
	print( "03.3" );
	// Find Slave TV.
	bob_device_role( $tvSlave, "m1-sc03-ro02" );
	print( "03.4" );
	// Sync client on master.
	mbrix_play_multi_room( $tvMaster, $tvSlave );
	print( "03: Started playback" );
	print( $tvMaster );
	print( $tvSlave );
}


////// Behavior Definition: Play/Pause TV (id "m1-sc04")

// Standard press: Play / Pause
event_reaction( event_trigger_pressed, $event )
{
	print( "04: trigger_pressed called." );
	print( $event );
	// Is the sending device configured as trigger in the behavior?
	bob_device_role( $event->zw_node_id, "m1-sc04-ro02" );
	// bob_device_role( $event->device, "m1-sc04-ro02" );
	"7" = $event->zw_scene_id;
	// Find Master TV.
	bob_device_role( $devTv, "m1-sc04-ro01" );
	// Send Pause key to TV (41 is code for pause)
	mbrix_inject_rc_key( $devTv, "41" );
	print( "04: Injected key to tv" );
	print( $devTv );
}

// Long press: Power off system
event_reaction( event_trigger_pressed, $event )
{
	print( "04.2: trigger_pressed called." );
	print( $event );
	// Is the sending device configured as trigger in the behavior?
	bob_device_role( $event->zw_node_id, "m1-sc04-ro02" );
	// bob_device_role( $event->device, "m1-sc04-ro02" );
	"8" = $event->zw_scene_id;
	// Find Master TV.
	bob_device_role( $devTv, "m1-sc04-ro01" );
	// Send Pause key to TV (41 is code for pause)
	// TXWTODO: Switch off TV here.
	print( "****** switch of TV here ******" );
	mbrix_inject_rc_key( $devTv, "41" );
	print( "04.2: Injected key to tv" );
	print( $devTv );
}


//// Power on system if controller is detected.

event_reaction( ip_controller_available, $event ) {
	bob_device_attribute( $devTv, "loewe_sync_avplayer" );
	bob_device_role( $devTv, $_anyrole );
	mbrix_wakeup( $devTv );
}
