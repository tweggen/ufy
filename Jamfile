
import os ;
local BOBDIR = [ os.environ BOBDIR ] ;
local BOBTARGET = [ os.environ BOBTARGET ] ;
local BOBINSTALLDIR = [ os.environ BOBINSTALLDIR ] ;

lib boost_filesystem : : <name>boost_filesystem ;
lib boost_system : : <name>boost_system ;
lib boost_thread : : <name>boost_thread ;
lib pthread : : <name>pthread ;
lib readline : : <name>readline ;
lib cpprest : : <name>cpprest ;

project
    : requirements 
    	<include>pubincs 
    	<include>src
    ;


lib vault-unify : [ glob src/*.cpp ] 
	/combine/modules/rest-server
	cpprest boost_filesystem boost_system boost_thread readline pthread ;


install install-bin : vault-unify : <location>"/${BOBINSTALLDIR}/lib" ; 
